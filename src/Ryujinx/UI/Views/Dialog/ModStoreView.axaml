<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    xmlns:models="clr-namespace:Ryujinx.Ava.UI.Models"
    Width="860"
    Height="770"
    mc:Ignorable="d"
    x:Class="Ryujinx.Ava.UI.Views.Dialog.ModStoreView"
    x:CompileBindings="True"
    x:DataType="viewModels:ModStoreViewModel"
    Focusable="True">
    <UserControl.Styles>
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppListHoverBackgroundColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Button.chip.chipSelected">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Warning banner -->
        <Border
            Grid.Row="0"
            Background="#33E0A030"
            BorderBrush="#E0A030"
            BorderThickness="1"
            CornerRadius="4"
            Margin="0 0 0 8"
            Padding="8 6">
            <TextBlock
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="#F0C060"
                Text="{ext:Locale Dialog_Nextendo_ModStoreWarning}" />
        </Border>

        <!-- Search + cosmetic toggle -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0 0 0 6">
            <TextBox
                Grid.Column="0"
                Watermark="{ext:Locale Dialog_Nextendo_ModStoreSearchPlaceholder}"
                Text="{Binding SearchText}"
                KeyDown="OnSearchKeyDown" />
            <Button Grid.Column="1" Margin="6 0 0 0" Click="OnSearchClick">
                <TextBlock Text="{ext:Locale Dialog_Nextendo_ModStoreSearchButton}" />
            </Button>
            <CheckBox
                Grid.Column="2"
                Margin="12 0 0 0"
                VerticalAlignment="Center"
                IsChecked="{Binding CosmeticOnly}"
                Content="{ext:Locale Dialog_Nextendo_ModStoreCosmeticOnly}" />
        </Grid>

        <!-- Category chips: wrap onto multiple lines (no ugly horizontal scrollbar over the chips);
             if there are a LOT of categories, a thin vertical scrollbar appears on the right. -->
        <ScrollViewer
            Grid.Row="2"
            Margin="0 0 0 8"
            MaxHeight="96"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="models:ModCategory">
                        <Button Classes="chip" Classes.chipSelected="{Binding Selected}" Padding="12 4" Margin="0 0 6 6" Click="OnCategoryClick">
                            <TextBlock Text="{Binding Label}" FontSize="12" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!-- Mod grid -->
        <Border
            Grid.Row="3"
            BorderBrush="{DynamicResource AppListHoverBackgroundColor}"
            BorderThickness="1"
            CornerRadius="5"
            Padding="3">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Mods}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="models:ModStoreItem">
                            <Border
                                Height="282"
                                Margin="6"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppListHoverBackgroundColor}"
                                ClipToBounds="True">
                                <Grid RowDefinitions="140,*">
                                    <!-- Click the preview to open the mod's GameBanana page -->
                                    <Panel Grid.Row="0" Background="#22000000" Cursor="Hand" Tapped="OnModTapped" ToolTip.Tip="{Binding Name}">
                                        <TextBlock
                                            Text="🖼"
                                            FontSize="28"
                                            Opacity="0.25"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Panel>
                                    <Button
                                        Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="4"
                                        Padding="7 1"
                                        Background="#99000000"
                                        CornerRadius="12"
                                        Click="OnFavoriteClick"
                                        ToolTip.Tip="{ext:Locale Dialog_Nextendo_ModStoreFavoriteHint}">
                                        <TextBlock Text="{Binding FavoriteGlyph}" FontSize="15" Foreground="#FF7DA8" />
                                    </Button>
                                    <Border
                                        Grid.Row="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="4"
                                        Padding="6 1"
                                        Background="#CCB03030"
                                        CornerRadius="10"
                                        IsVisible="{Binding HasConflict}"
                                        ToolTip.Tip="{ext:Locale Dialog_Nextendo_ModStoreConflictHint}">
                                        <TextBlock Text="⚠" FontSize="13" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="8 6" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Cursor="Hand" Tapped="OnModTapped" />
                                        <TextBlock Text="{Binding MetaText}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatsText}" FontSize="10" Opacity="0.5" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 5 0 0">
                                            <Button
                                                Padding="14 5"
                                                IsEnabled="{Binding !Busy}"
                                                IsVisible="{Binding !Installed}"
                                                Click="Download">
                                                <TextBlock Text="{ext:Locale Dialog_Nextendo_ModStoreInstall}" />
                                            </Button>
                                            <Button
                                                Padding="14 5"
                                                IsEnabled="{Binding !Busy}"
                                                IsVisible="{Binding UpdateAvailable}"
                                                Background="{DynamicResource SystemAccentColor}"
                                                Click="Download">
                                                <TextBlock Text="{ext:Locale Dialog_Nextendo_ModStoreUpdate}" />
                                            </Button>
                                            <Button
                                                Padding="14 5"
                                                IsEnabled="{Binding !Busy}"
                                                IsVisible="{Binding Installed}"
                                                Click="Delete">
                                                <TextBlock Text="{ext:Locale Dialog_Nextendo_ModStoreRemove}" />
                                            </Button>
                                        </StackPanel>
                                        <CheckBox
                                            IsVisible="{Binding Installed}"
                                            IsChecked="{Binding Enabled}"
                                            Click="OnToggleEnabled"
                                            Margin="0 3 0 0">
                                            <TextBlock Text="{ext:Locale Dialog_Nextendo_ModStoreEnabled}" FontSize="11" />
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer: status + load more (Close = native ContentDialog button) -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0 8 0 0">
            <TextBlock Grid.Column="0" Text="{Binding Status}" Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" MinWidth="110" IsVisible="{Binding CanLoadMore}" Click="OnLoadMore">
                <TextBlock Text="{ext:Locale Dialog_Nextendo_ModStoreLoadMore}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
