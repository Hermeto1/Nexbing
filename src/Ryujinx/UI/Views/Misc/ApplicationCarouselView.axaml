<UserControl
    x:Class="Ryujinx.Ava.UI.Views.Misc.ApplicationCarouselView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Ryujinx.Ava.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Ryujinx.Ava.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Ryujinx.Ava.UI.Models"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    Focusable="True"
    mc:Ignorable="d"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    x:DataType="viewModels:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="Button.RoundIconButton">
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.RoundIconButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#44000000" />
        </Style>
        <Style Selector="Button.RoundIconButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#55000000" />
        </Style>
        <Style Selector="Button.RoundIconButton.carouselBottomSelected">
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="2.5" />
        </Style>
        <Style Selector="Button.RoundIconButton.carouselBottomSelected /template/ ContentPresenter">
            <Setter Property="Background" Value="#663EE8C8" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*">
        <!-- [Nextendo] Fondo de pantalla seleccionable (cargado desde config) -->
        <Image
            Name="WallpaperBackground"
            Grid.RowSpan="2"
            Stretch="UniformToFill"
            IsHitTestVisible="False"
            ZIndex="-1" />
        <!-- Barra superior estilo Switch: perfil (izq) + reloj/indicadores (der) -->
        <Grid
            Grid.Row="0"
            Margin="16,10,16,0"
            ColumnDefinitions="Auto,*,Auto">
            <!-- Boton circular de perfil -->
            <Button
                Grid.Column="0"
                Width="76"
                Height="76"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Click="ProfileButton_OnClick"
                ToolTip.Tip="Nextendo">
                <Grid>
                    <Border
                        Width="72"
                        Height="72"
                        ClipToBounds="True"
                        CornerRadius="36"
                        BorderBrush="#4A4A4A"
                        BorderThickness="1.5">
                        <Grid>
                            <Image
                                Name="ProfileAvatarImage"
                                Width="72"
                                Height="72"
                                Stretch="UniformToFill" />
                            <Ellipse
                                IsHitTestVisible="False"
                                Width="72"
                                Height="72"
                                Stroke="#4A4A4A"
                                StrokeThickness="1.5" />
                        </Grid>
                    </Border>
                    <Border
                        Name="ProfileSelectionRing"
                        Width="80"
                        Height="80"
                        CornerRadius="40"
                        BorderBrush="#FF33E86B"
                        BorderThickness="3"
                        IsVisible="False"
                        IsHitTestVisible="False" />
                </Grid>
            </Button>
            <!-- Indicadores de conexion + reloj a la derecha -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="StatusButton_OnClick"
                        ToolTip.Tip="Estado del servicio (nextendo.network/status)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Name="NextendoStatusDot" Width="10" Height="10" Fill="#7A7A7A" VerticalAlignment="Center" />
                            <TextBlock Text="Nextendo" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Tipo de conexion: barras si ethernet, icono wi-fi si wi-fi -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Name="EthSignalBars" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsVisible="False">
                        <Rectangle Name="EthBar1" Width="3" Height="6" Fill="#7A7A7A" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                        <Rectangle Name="EthBar2" Width="3" Height="9" Fill="#7A7A7A" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                        <Rectangle Name="EthBar3" Width="3" Height="12" Fill="#7A7A7A" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                        <Rectangle Name="EthBar4" Width="3" Height="15" Fill="#7A7A7A" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                    </StackPanel>
                    <ui:SymbolIcon Name="WifiStrengthSymbol" Symbol="Wifi3" FontSize="17" Foreground="#7A7A7A" VerticalAlignment="Center" IsVisible="False" />
                </StackPanel>
                <TextBlock
                    Name="ClockTextBlock"
                    Text="--:--"
                    FontSize="18"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <!-- Carrusel de juegos -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="0,0,0,20">
        <ListBox
            Name="CarouselList"
            Grid.Row="0"
            Padding="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent"
            SelectionMode="Single"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            KeyDown="CarouselList_KeyDown"
            RightTapped="CarouselList_RightTapped"
            DoubleTapped="CarouselList_DoubleTapped"
            ItemsSource="{Binding AppsObservableList}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Margin" Value="12,0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel VerticalAlignment="Center">
                            <Grid
                                Width="{Binding $parent[UserControl].((viewModels:MainWindowViewModel)DataContext).CarouselItemSize}"
                                Height="{Binding $parent[UserControl].((viewModels:MainWindowViewModel)DataContext).CarouselItemSize}">
                                <Border
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AppListBackgroundColor}"
                                    BorderBrush="#3A3A3A"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="8">
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        RenderOptions.BitmapInterpolationMode="HighQuality"
                                        Source="{Binding Icon, Converter={x:Static helpers:BitmapArrayValueConverter.Instance}}" />
                                </Border>
                            </Grid>
                            <!-- [Nextendo] Live player count, top-left; hidden at zero. -->
                            <Border
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="4,4,0,0"
                                Background="#E60B0D12"
                                BorderBrush="#33E86B"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,1">
                                <ToolTipService.ToolTip>
                                    <TextBlock Text="{Binding NextendoPlayersText}" />
                                </ToolTipService.ToolTip>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="5" Height="5" Fill="#33E86B" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NextendoPlayersOnline}" FontSize="10" FontWeight="SemiBold" Foreground="#33E86B" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Text="{Binding Name}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="{Binding $parent[UserControl].((viewModels:MainWindowViewModel)DataContext).CarouselItemSize}"
                                IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Separador + botones redondos (website / Discord / noticias) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,4" Orientation="Vertical" Spacing="12">
                <Border Height="1" HorizontalAlignment="Stretch" Background="#33808080" IsHitTestVisible="False" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Button
                        x:Name="WebsiteButton"
                        Classes="RoundIconButton"
                        Width="60"
                        Height="60"
                        Click="WebsiteButton_OnClick"
                        ToolTip.Tip="Sitio web">
                        <Image
                            Source="resm:Ryujinx.Assets.UIImages.Logo_Web_Nextendo.png?assembly=Ryujinx"
                            Width="30"
                            Height="30"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="DiscordButton"
                        Classes="RoundIconButton"
                        Width="60"
                        Height="60"
                        Click="DiscordButton_OnClick"
                        ToolTip.Tip="Discord">
                        <!-- SVG vectorial se asignará en code-behind -->
                    </Button>
                    <Button
                        x:Name="NewsButton"
                        Classes="RoundIconButton"
                        Width="60"
                        Height="60"
                        Click="NewsButton_OnClick"
                        ToolTip.Tip="Noticias">
                        <Grid Width="26" Height="26">
                            <Border
                                Width="24"
                                Height="24"
                                CornerRadius="3"
                                BorderBrush="#CFCFCF"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <StackPanel Margin="3" Spacing="2" IsHitTestVisible="False">
                                <Rectangle Height="2" Fill="#CFCFCF" RadiusX="1" RadiusY="1" />
                                <Rectangle Height="2" Fill="#CFCFCF" RadiusX="1" RadiusY="1" />
                                <Rectangle Width="12" HorizontalAlignment="Left" Height="2" Fill="#CFCFCF" RadiusX="1" RadiusY="1" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
